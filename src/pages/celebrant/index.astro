---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import CelebrantNav from '../../components/CelebrantNav.astro';
import CelebrantFooter from '../../components/CelebrantFooter.astro';

const reviews = [
  { quote: "It was Tom's first run as a celebrant and I already had other guests asking if he was available to do their wedding. He was truly a natural; eloquent, witty and personable with real attention to detail and great communication.", who: "Joe and Molly, Quamby Estate, TAS" },
  { quote: "Tom was interested and interesting, attentive and so kind! He held the most amazing space full of life and energy at our wedding and included our family including two young kids in all we did. We won't forget how much he set the scene and brought us together for our wedding day. My nanna loved him and so did my aunties.", who: "Zoe and Will, Kangaroobie, VIC" },
  { quote: "What a joy and honour it was to work with Tom to create the marriage ceremony of our dreams. Tom was instrumental in crafting the structure of our ceremony so that the magic could flow so beautifully on the day. He had such a grounding influence on us throughout the whole process, getting things organised well in advance so that we were able to 'let go' as the wedding storm swept us up.", who: "Michaela and Lachie, Stieglitz, VIC" },
  { quote: "Tom was excellent. Punctual, efficient, laid back, funny, charming and kind. We were very satisfied with his work, would definitely recommend his services to others!", who: "Courtney and Conor, Warrnambool, VIC" },
  { quote: "Tom was an absolute delight. From our very first meeting, we knew we wanted him to be our celebrant. Finding someone to officiate such an important moment requires a great deal of trust, and Tom exceeded our expectations. Throughout the entire process, he brought a positive, kind, and supportive energy that made everything feel easy and comfortable. He took the time to understand us and thoughtfully tailored the ceremony to suit our preferences, creating something that felt genuinely personal and perfect for us. Thank you, Tom!", who: "Cameron and Melisa, Melbourne, VIC" },
  { quote: "Tom was fantastic for our small wedding! We wanted short and sweet and he delivered. He was super easy to work with and so relaxed. Highly recommend!!", who: "Tegan and Brendan, Warrnambool, VIC" },
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "name": "Tom Allen — Marriage Celebrant",
  "description": "Wedding ceremonies that feel like you. Darwin-based Authorised Marriage Celebrant serving the Northern Territory and Australia-wide.",
  "url": "https://tomallen.com.au/celebrant/",
  "telephone": "+61421102154",
  "email": "allen.tom.c@gmail.com",
  "image": "https://tomallen.com.au/images/celebrant/hero.webp",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Darwin",
    "addressRegion": "Northern Territory",
    "addressCountry": "AU"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -12.4634,
    "longitude": 130.8456
  },
  "areaServed": [
    { "@type": "City", "name": "Darwin" },
    { "@type": "AdministrativeArea", "name": "Northern Territory" },
    { "@type": "Country", "name": "Australia" }
  ],
  "priceRange": "$$",
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "Certificate IV in Celebrancy",
    "recognizedBy": {
      "@type": "Organization",
      "name": "Attorney-General's Department of Australia"
    }
  },
  "knowsAbout": ["wedding ceremonies", "marriage ceremonies", "same-sex weddings", "civil ceremonies", "elopements"]
};
---

<BaseLayout title="Tom Allen — Marriage Celebrant, Darwin NT" description="Wedding ceremonies that feel like you. Marriage celebrant based in Darwin, Northern Territory." section="celebrant" preloadImage="/images/celebrant/hero.webp">
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <Nav section="celebrant" />
  <CelebrantNav activePage="home" />

  <main style="padding-top: 96px;">
    <!-- Hero -->
    <section class="cel-hero">
      <img src="/images/celebrant/gallery/15.webp" alt="Wedding ceremony" class="cel-hero__img" width="1920" height="1280" loading="eager" fetchpriority="high" decoding="async" onerror="this.style.display='none'" />
      <div class="cel-hero__overlay">
        <div class="cel-hero__content">
          <p class="fade-in label" style="color: #FFFFFF; margin-bottom: 16px; opacity: 0.8;">Marriage Celebrant — Darwin, NT</p>
          <h1 class="fade-in cel-hero__title" data-delay="200">Ceremonies that<br />feel like you</h1>
        </div>
      </div>
    </section>

    <!-- Hero Intro -->
    <section class="cel-intro">
      <div class="cel-intro__content fade-in">
        <p class="cel-intro__desc">
          The wedding ceremonies I craft are all about presence. Even despite our best efforts, our wedding days are usually a blur. The opportunity I present to you as your celebrant is not more noise, more chatter, more intensity, but a moment of pause, of presence, to see clearly where you've come from and where you're choosing to go.
        </p>
        <div class="cel-intro__actions">
          <a href="/celebrant/enquire/" class="btn" style="background: var(--cel-accent); color: #FFFFFF; font-weight: 600;">Get in Touch</a>
          <a href="/celebrant/how-i-work/" class="btn btn-outline">How I Work</a>
        </div>
      </div>
    </section>

    <!-- Three Value Props -->
    <section class="container-wide fade-in" style="padding: 80px 32px 60px;">
      <div class="cel-values">
        <div class="cel-values__item">
          <h3>A Time to Connect</h3>
          <p>Weddings are about stories, old and new. Weddings bring us together. My role as a celebrant is to help you tell your story and connect with your people authentically.</p>
        </div>
        <div class="cel-values__item">
          <h3>A Time to Celebrate</h3>
          <p>Weddings should be fun. They are opportunities for us to fill our cup, to be joyful, to share hope, and to share in the wonder and mystery of love. My job is to help you make it fun, whatever that means to you. Introverts, extroverts, big weddings or small: this is a day to remember.</p>
        </div>
        <div class="cel-values__item">
          <h3>A Day to Reflect</h3>
          <p>Life is full of challenges and mundane moments. A wedding is neither of those. It is a chance to take a deep breath and state what is most true to you, what you feel in your bones. I'm here to hold a little space for you to bring your best selves and have a moment to reflect on the preciousness of life.</p>
        </div>
      </div>
    </section>

    <!-- Photo Gallery -->
    <section class="container-full fade-in" data-delay="100" style="padding: 0 32px 80px;">
      <div class="cel-gallery">
        <div class="cel-gallery__portrait">
          <img src="/images/celebrant/gallery-5.webp" alt="Tom Allen officiating a same-sex wedding ceremony, two grooms holding hands at an intimate indoor venue" width="600" height="900" loading="lazy" decoding="async" onload="this.classList.add('loaded')" onerror="this.parentElement.classList.add('placeholder-img','placeholder-img--warm')" />
        </div>
        <div class="cel-gallery__col">
          <div class="cel-gallery__cell">
            <img src="/images/celebrant/gallery-1.webp" alt="Newlyweds walking back up the aisle as guests shower them with confetti at an outdoor garden wedding" width="600" height="400" loading="lazy" decoding="async" onload="this.classList.add('loaded')" onerror="this.parentElement.classList.add('placeholder-img','placeholder-img--warm')" />
          </div>
          <div class="cel-gallery__cell">
            <img src="/images/celebrant/gallery-2.webp" alt="Tom Allen officiating an outdoor garden wedding ceremony as the groom and groomsmen smile" width="600" height="400" loading="lazy" decoding="async" onload="this.classList.add('loaded')" onerror="this.parentElement.classList.add('placeholder-img','placeholder-img--dark')" />
          </div>
        </div>
        <div class="cel-gallery__col">
          <div class="cel-gallery__cell">
            <img src="/images/celebrant/gallery-3.webp" alt="Tom Allen and a couple celebrating after an intimate outdoor bush ceremony among Australian gum trees" width="600" height="400" loading="lazy" decoding="async" onload="this.classList.add('loaded')" onerror="this.parentElement.classList.add('placeholder-img','placeholder-img--warm')" />
          </div>
          <div class="cel-gallery__cell">
            <img src="/images/celebrant/gallery-4.webp" alt="Tom Allen watching as a newly married couple embrace at a relaxed bohemian bush wedding ceremony" width="600" height="400" loading="lazy" decoding="async" onload="this.classList.add('loaded')" onerror="this.parentElement.classList.add('placeholder-img','placeholder-img--cool')" />
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Carousel -->
    <section class="cel-testimonials">
      <div class="testimonial-viewport" id="testimonialViewport">
        <div class="testimonial-track" id="testimonialTrack">
          {reviews.map((t, i) => (
            <blockquote class:list={["testimonial-card", { active: i === 0 }]}>
              <p class="cel-quote__text">"{t.quote}"</p>
              <footer class="cel-quote__who">— {t.who}</footer>
            </blockquote>
          ))}
        </div>
      </div>
      <div class="testimonial-nav">
        <button id="testimonialPrev" class="testimonial-arrow" aria-label="Previous review">&#8592;</button>
        <div class="testimonial-dots">
          {reviews.map((_, i) => (
            <button class:list={["testimonial-dot", { active: i === 0 }]} data-idx={String(i)} aria-label={`Go to review ${i + 1}`}></button>
          ))}
        </div>
        <button id="testimonialNext" class="testimonial-arrow" aria-label="Next review">&#8594;</button>
      </div>
    </section>

    <!-- CTA -->
    <section style="padding: 80px 32px; text-align: center;">
      <div class="fade-in">
        <h2 class="font-heading" style="font-size: 32px; font-weight: 400; font-style: italic; color: var(--cel-text); margin-bottom: 16px;">Let's talk about your day</h2>
        <p class="font-body" style="font-size: 16px; color: var(--cel-subtle); font-weight: 300; margin-bottom: 28px;">No commitment. Just a conversation.</p>
        <a href="/celebrant/enquire/" class="btn" style="background: var(--cel-accent); color: #FFF;">Enquire Now</a>
      </div>
    </section>

    <CelebrantFooter />
  </main>

  <!-- Lightbox -->
  <div id="cel-lightbox" class="cel-lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <button class="cel-lightbox__close" id="cel-lightbox-close" aria-label="Close">&#215;</button>
    <img id="cel-lightbox-img" src="" alt="" class="cel-lightbox__img" />
  </div>
</BaseLayout>

<style>
  .cel-hero {
    position: relative;
    overflow: hidden;
    min-height: max(100vh, 650px);
    background: linear-gradient(135deg, #1E3A1A 0%, #2A5020 40%, #0F2010 100%);
  }

  .cel-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 85%;
  }

  .cel-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,25,10,0.05) 0%, rgba(10,25,10,0.60) 100%);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 120px;
  }

  .cel-hero__content {
    text-align: center;
    padding: 32px;
    max-width: 700px;
  }

  .cel-hero__title {
    font-family: 'Source Serif 4', serif;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 400;
    font-style: italic;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 0;
  }

  .cel-intro {
    padding: 60px 32px;
    border-bottom: 1px solid color-mix(in srgb, var(--cel-accent) 12%, transparent);
  }

  .cel-intro__content {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  .cel-intro__desc {
    font-family: 'Source Serif 4', serif;
    font-size: 18px;
    line-height: 1.8;
    color: var(--cel-text);
    font-weight: 300;
    margin-bottom: 36px;
  }

  .cel-intro__actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cel-values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px;
    max-width: 850px;
    margin: 0 auto;
  }

  .cel-values__item {
    text-align: center;
  }

  .cel-values__item h3 {
    font-family: 'Source Serif 4', serif;
    font-size: 18px;
    font-weight: 600;
    font-style: italic;
    color: var(--cel-text);
    margin-bottom: 12px;
  }

  .cel-values__item p {
    font-family: 'Source Serif 4', serif;
    font-size: 14px;
    line-height: 1.7;
    color: var(--cel-subtle);
    font-weight: 300;
  }

  .cel-gallery {
    display: flex;
    gap: 12px;
    max-width: 1000px;
    margin: 0 auto;
    align-items: stretch;
  }

  .cel-gallery__portrait {
    flex: 1;
    border-radius: 6px;
    overflow: hidden;
  }

  .cel-gallery__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cel-gallery__col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cel-gallery__cell {
    flex: 1;
    border-radius: 6px;
    overflow: hidden;
    min-height: 0;
  }

  .cel-gallery__cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cel-testimonials {
    background: color-mix(in srgb, var(--cel-accent) 4%, transparent);
    padding: 70px 0 56px;
    overflow: hidden;
  }

  .testimonial-viewport {
    overflow: hidden;
    position: relative;
  }

  .testimonial-track {
    display: flex;
    gap: 24px;
    position: relative;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  .testimonial-card {
    flex: 0 0 min(580px, 68%);
    margin: 0;
    padding: 40px 44px;
    background: #fff;
    border-radius: 6px;
    opacity: 0.32;
    transform: scale(0.97);
    transition: opacity 0.4s ease, transform 0.4s ease;
    cursor: pointer;
    box-shadow: 0 2px 20px rgba(30, 58, 26, 0.07);
  }

  .testimonial-card.active {
    opacity: 1;
    transform: scale(1);
    cursor: default;
  }

  .cel-quote__text {
    font-family: 'Source Serif 4', serif;
    font-size: 18px;
    font-style: italic;
    line-height: 1.75;
    color: var(--cel-text);
    font-weight: 400;
    margin-bottom: 20px;
  }

  .cel-quote__who {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: var(--cel-subtle);
  }

  .testimonial-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 36px;
    padding: 0 32px;
  }

  .testimonial-arrow {
    background: none;
    border: 1px solid color-mix(in srgb, var(--cel-accent) 40%, transparent);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--cel-accent);
    font-size: 16px;
    transition: background 0.2s, border-color 0.2s;
    flex-shrink: 0;
  }

  .testimonial-arrow:hover {
    background: color-mix(in srgb, var(--cel-accent) 8%, transparent);
    border-color: var(--cel-accent);
  }

  .testimonial-dots {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .testimonial-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--cel-accent) 22%, transparent);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .testimonial-dot.active {
    background: var(--cel-accent);
    transform: scale(1.35);
  }

  @media (max-width: 640px) {
    .testimonial-card {
      flex: 0 0 82%;
      padding: 28px 28px;
    }
    .cel-quote__text { font-size: 16px; }
  }

  .cel-gallery__portrait img,
  .cel-gallery__cell img {
    cursor: zoom-in;
    transition: opacity 0.2s;
  }

  .cel-gallery__portrait img:hover,
  .cel-gallery__cell img:hover {
    opacity: 0.88;
  }

  .cel-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }

  .cel-lightbox.active {
    display: flex;
  }

  .cel-lightbox__img {
    max-width: calc(100vw - 64px);
    max-height: calc(100vh - 64px);
    object-fit: contain;
    border-radius: 4px;
    cursor: default;
  }

  .cel-lightbox__close {
    position: absolute;
    top: 20px;
    right: 24px;
    background: none;
    border: none;
    color: #fff;
    font-size: 32px;
    line-height: 1;
    padding: 4px 8px;
    cursor: pointer;
    opacity: 0.6;
  }

  .cel-lightbox__close:hover {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .cel-gallery {
      flex-direction: column;
    }
    .cel-gallery__col {
      flex-direction: row;
    }
  }
</style>

<script is:inline>
  (function () {
    var lightbox = document.getElementById('cel-lightbox');
    var lightboxImg = document.getElementById('cel-lightbox-img');
    var lightboxClose = document.getElementById('cel-lightbox-close');

    document.querySelectorAll('.cel-gallery img').forEach(function (img) {
      img.addEventListener('click', function () {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.classList.add('active');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    lightbox.addEventListener('click', function (e) {
      if (e.target !== lightboxImg) closeLightbox();
    });

    lightboxClose.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeLightbox();
    });
  })();
</script>

<script is:inline>
  (function () {
    var viewport = document.getElementById('testimonialViewport');
    var track = document.getElementById('testimonialTrack');
    if (!viewport || !track) return;

    var cards = Array.from(track.querySelectorAll('.testimonial-card'));
    var dots = Array.from(document.querySelectorAll('.testimonial-dot'));
    var current = 0;

    function goTo(idx) {
      if (idx < 0) idx = cards.length - 1;
      if (idx >= cards.length) idx = 0;
      current = idx;

      var card = cards[current];
      var vpW = viewport.offsetWidth;
      var translateX = vpW / 2 - card.offsetLeft - card.offsetWidth / 2;
      track.style.transform = 'translateX(' + translateX + 'px)';

      cards.forEach(function (c, i) { c.classList.toggle('active', i === current); });
      dots.forEach(function (d, i) { d.classList.toggle('active', i === current); });
    }

    document.getElementById('testimonialPrev').addEventListener('click', function () { goTo(current - 1); });
    document.getElementById('testimonialNext').addEventListener('click', function () { goTo(current + 1); });

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () { goTo(i); });
    });

    cards.forEach(function (card, i) {
      card.addEventListener('click', function () { if (i !== current) goTo(i); });
    });

    var startX = 0;
    viewport.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    viewport.addEventListener('touchend', function (e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
    });

    window.addEventListener('resize', function () { goTo(current); });

    goTo(0);
  })();
</script>
