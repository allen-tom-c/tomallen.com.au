---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import CelebrantNav from '../../components/CelebrantNav.astro';
import CelebrantFooter from '../../components/CelebrantFooter.astro';
---

<BaseLayout title="Enquire — Tom Allen Celebrant" description="Get in touch about your wedding ceremony." section="celebrant">
  <Nav section="celebrant" />
  <CelebrantNav activePage="enquire" />

  <main style="padding-top: 96px;">
    <section class="container-narrow" style="padding: 60px 32px 80px;">
      <div id="enquiry-intro" class="fade-in">
        <h1 class="font-heading" style="font-size: 40px; font-weight: 400; font-style: italic; color: var(--cel-text); margin-bottom: 16px;">Get in Touch</h1>
        <p class="font-body" style="font-size: 17px; line-height: 1.8; color: var(--cel-subtle); font-weight: 300; margin-bottom: 40px;">Tell me a little about you and what you're imagining.</p>
      </div>

      <div id="enquiry-success" class="enquiry-success" style="display: none;">
        <p>Thanks — I'll be in touch soon.</p>
      </div>

      <form id="enquiry-form" class="fade-in enquiry-form" data-delay="200" method="POST" action="https://formspree.io/f/xgoljrve">
        <div class="enquiry-form__row">
          <div class="enquiry-form__field">
            <label class="form-label" style="color: var(--cel-subtle);">Your name(s)</label>
            <input type="text" name="names" class="form-input" placeholder="e.g. Sarah & James" required style="border-color: color-mix(in srgb, var(--cel-accent) 15%, transparent); color: var(--cel-text);" />
          </div>
          <div class="enquiry-form__field">
            <label class="form-label" style="color: var(--cel-subtle);">Email</label>
            <input type="email" name="email" class="form-input" placeholder="you@email.com" required style="border-color: color-mix(in srgb, var(--cel-accent) 15%, transparent); color: var(--cel-text);" />
          </div>
        </div>
        <div class="enquiry-form__field">
          <label class="form-label" style="color: var(--cel-subtle);">When are you thinking?</label>
          <input type="text" name="date" class="form-input" placeholder="e.g. June 2026, or 'not sure yet'" style="border-color: color-mix(in srgb, var(--cel-accent) 15%, transparent); color: var(--cel-text);" />
        </div>
        <div class="enquiry-form__field">
          <label class="form-label" style="color: var(--cel-subtle);">Tell me about your day</label>
          <textarea name="message" rows="5" class="form-input" placeholder="Where you're thinking, how many guests, what vibe — or just say hello." style="border-color: color-mix(in srgb, var(--cel-accent) 15%, transparent); color: var(--cel-text); resize: vertical;"></textarea>
        </div>
        <div class="enquiry-form__honeypot" aria-hidden="true">
          <label>Leave this field blank</label>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn" style="background: var(--cel-accent); color: #FFF;">Send Enquiry</button>
      </form>
    </section>

    <CelebrantFooter />
  </main>
</BaseLayout>

<script>
  // Client-side spam filter. If a submission contains any of these phrases,
  // we silently show the success message but don't actually POST to Formspree —
  // the spammer thinks it worked and moves on. Honeypot catches dumb bots;
  // this catches smarter bots and human spammers by content. List is biased
  // toward multi-word phrases that no real wedding enquirer would ever use.
  // Add new entries here as new spam patterns appear.
  const SPAM_KEYWORDS = [
    // business funding / loan spam
    'borrowing power', 'business loan', 'business funding', 'commercial financing',
    'credit score', 'credit application', 'loan options', 'loan rates',
    'funding solutions', 'funding potential', 'no credit impact',
    'hellorates',
    // SEO / marketing / web design spam
    'seo services', 'search engine ranking', 'rank your website', 'rank higher',
    'improve your ranking', 'increase traffic', 'guest post', 'link exchange',
    'lead generation', 'digital marketing services', 'web design services',
    // crypto spam
    'cryptocurrency', 'blockchain investment', 'nft project',
    // streaming TV / advertising spam (topshelfpromotion, May 2026)
    'topshelfpromotion', 'qualified homeowner', 'big-screen', 'big screen tv',
    'live sports', 'your brand', 'your business on', 'your business in',
    'roku', 'hulu',
    // generic B2B sales pitch language — no wedding enquirer would write these
    'flat rate.', 'we put your', 'your customers', 'your client base',
  ];

  function looksLikeSpam(data: FormData): boolean {
    const haystack = [
      data.get('names'), data.get('email'), data.get('date'), data.get('message'),
    ].filter(Boolean).join(' ').toLowerCase();
    return SPAM_KEYWORDS.some(kw => haystack.includes(kw));
  }

  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const success = document.getElementById('enquiry-success') as HTMLElement;
  const intro = document.getElementById('enquiry-intro') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    if (looksLikeSpam(data)) {
      intro.style.display = 'none';
      form.style.display = 'none';
      success.style.display = 'block';
      return;
    }

    const response = await fetch(form.action, {
      method: 'POST',
      body: data,
      headers: { 'Accept': 'application/json' },
    });
    if (response.ok) {
      intro.style.display = 'none';
      form.style.display = 'none';
      success.style.display = 'block';
    }
  });
</script>

<style>
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .enquiry-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .enquiry-form__field {
    display: flex;
    flex-direction: column;
  }

  /* Honeypot field — visually hidden but present in the DOM. Spam bots fill in
     every field they find; legitimate users never see this. Formspree silently
     discards any submission where the _gotcha field contains a value. We avoid
     display:none because some smarter bots check for it and skip the field. */
  .enquiry-form__honeypot {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .enquiry-success {
    background: color-mix(in srgb, var(--cel-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--cel-accent) 25%, transparent);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 32px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: var(--cel-text);
  }

  @media (max-width: 540px) {
    .enquiry-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
